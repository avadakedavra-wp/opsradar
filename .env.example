# --- AI backend (pick one; AGENT_BACKEND=auto uses whichever is configured) ---
AGENT_BACKEND=auto
# Real, working option: an Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5. Use claude-sonnet-5 or claude-haiku-4-5
# for a cheaper/faster tier on large clusters.
ANTHROPIC_MODEL=
# Alternative: the `bob` CLI, if you actually have it installed and on PATH.
BOB_BIN=bob
# Per-task / whole-scan timeouts (Go duration strings, e.g. "3m", "10m").
BOB_TASK_TIMEOUT=3m
BOB_SCAN_TIMEOUT=10m

# --- Kubernetes ---
# Leave unset to use the default kubeconfig context ($KUBECONFIG or
# ~/.kube/config) — that's almost always what you want.
KUBECONFIG=

# --- Storage ---
# Leave unset for a local run — defaults to ~/.opsradar/ops-radar.db.
# Set explicitly in containers (e.g. /data/ops-radar.db onto a mounted volume).
STORE_PATH=

# --- GitHub (for PR generation) ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- API ---
OPS_RADAR_API_KEY=
PORT=8080
